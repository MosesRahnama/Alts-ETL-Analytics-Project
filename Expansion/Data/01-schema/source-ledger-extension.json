{
  "version": "2026-09-expansion-pre-extraction",
  "key": "file_id",
  "rule": "Do not mutate the existing 28-column source_ledger schema until migration tests explicitly approve it. Store expansion-only acquisition metadata beside it and join by file_id.",
  "fields": [
    {"name":"file_id","type":"string","required":true},
    {"name":"source_system","type":"enum","required":true,"values":["SEC_EDGAR","PUBLIC_INSTITUTION","ILPA","ADVISOR_PUBLIC","REGISTRY","AUTHORIZED_PORTAL","LICENSED_VENDOR","OTHER_PUBLIC"]},
    {"name":"source_record_id","type":"string","required":false},
    {"name":"regulatory_form","type":"string","required":false},
    {"name":"sec_cik","type":"string","required":false},
    {"name":"sec_accession","type":"string","required":false},
    {"name":"filing_date","type":"date","required":false},
    {"name":"period_of_report","type":"date","required":false},
    {"name":"exhibit_type","type":"string","required":false},
    {"name":"exhibit_sequence","type":"string","required":false},
    {"name":"native_source_url","type":"uri","required":true},
    {"name":"native_file_ext","type":"string","required":true},
    {"name":"native_sha256","type":"sha256","required":true},
    {"name":"canonical_pdf_sha256","type":"sha256","required":false},
    {"name":"derived_from_native_sha256","type":"sha256","required":false},
    {"name":"renderer_id","type":"string","required":false},
    {"name":"document_family","type":"string","required":true},
    {"name":"document_subtype","type":"string","required":true},
    {"name":"deal_context","type":"enum","required":true,"values":["NONE","LP_LED","GP_LED","CONTINUATION","CO_INVEST_SECONDARY","PRIVATE_CREDIT_SECONDARY","FUND_FINANCING","PORTCO_TRANSACTION","UNKNOWN"]},
    {"name":"lookthrough_level","type":"enum","required":true,"values":["NONE","FUND_INTEREST","UNDERLYING_FUND","PORTFOLIO_COMPANY","SECURITY_OR_LOAN","MULTI_LEVEL","UNKNOWN"]},
    {"name":"package_id","type":"string","required":false},
    {"name":"parent_file_id","type":"string","required":false},
    {"name":"version_status","type":"enum","required":true,"values":["ORIGINAL","AMENDMENT","RESTATEMENT","DRAFT","FINAL","EXECUTED","CLOSING","UNKNOWN"]},
    {"name":"execution_status","type":"enum","required":true,"values":["NOT_APPLICABLE","DRAFT","FINAL_UNEXECUTED","EXECUTED","AMENDED","UNKNOWN"]},
    {"name":"access_basis","type":"enum","required":true,"values":["PUBLIC","PUBLIC_RECORDS_RESPONSE","CUSTOMER_AUTHORIZED","INTERNAL_OWNED","LICENSED"]},
    {"name":"confidentiality_class","type":"enum","required":true,"values":["PUBLIC","RESTRICTED","CONFIDENTIAL","HIGH_SENSITIVITY"]},
    {"name":"redistribution_rights","type":"enum","required":true,"values":["PUBLIC_REDISTRIBUTABLE","INTERNAL_ONLY","LICENSE_RESTRICTED","NO_REDISTRIBUTION","UNKNOWN"]},
    {"name":"pii_class","type":"enum","required":true,"values":["NONE","LOW","SENSITIVE_TAX_OR_IDENTITY"]},
    {"name":"license_contract_id","type":"string","required":false},
    {"name":"duplicate_of_file_id","type":"string","required":false},
    {"name":"supersedes_file_id","type":"string","required":false},
    {"name":"admission_status","type":"enum","required":true,"values":["CANDIDATE","FETCHED","HOLD","REJECTED","ADMITTED"]},
    {"name":"admission_reason","type":"string","required":false}
  ]
}